# Copy to $CODEX_HOME/config.toml INSIDE the devcontainer only. approval_policy = "never" is unacceptable on the host.
model = "gpt-6-astra"                # confirm exact id in Codex (§13)
approval_policy = "never"            # container only
sandbox_mode = "workspace-write"

[agents]
max_threads = 6
max_depth = 1

[mcp_servers.github]
command = "github-mcp-server"
args = ["stdio"]
env = { GITHUB_PERSONAL_ACCESS_TOKEN = "${GH_READ_TOKEN}" }

    "bus":     { "command": "uv", "args": ["run", "python", "-m", "orchestrator.bus_mcp"] },
    "github":  { "command": "github-mcp-server", "args": ["stdio", "--read-only", "--toolsets", "repos,issues,pull_requests"], "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GH_READ_TOKEN}" } }
}}

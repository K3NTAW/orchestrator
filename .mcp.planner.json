{ "mcpServers": {
    "codex":        { "command": "codex", "args": ["mcp-server"] },
    "orchestrator": { "command": "uv", "args": ["run", "python", "-m", "orchestrator.mcp"] },
    "bus":          { "command": "uv", "args": ["run", "python", "-m", "orchestrator.bus_mcp"] },
    "github":       { "command": "github-mcp-server", "args": ["stdio"], "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GH_WRITE_TOKEN}" } }
}}

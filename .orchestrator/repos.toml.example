# orchestrator serve resolves a slug in the request path/body to a repo config here.
# path must exist on disk (or be creatable via git_url); an entry without git_url is
# never auto-cloned -- a missing path then refuses with "repo path missing and no git_url".
#
# [myrepo]
# path = "/home/user/repos/myrepo"
# git_url = "https://github.com/example/myrepo.git"

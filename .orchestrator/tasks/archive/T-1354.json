      {
        "path": "orchestrator/daemon.py",
        "line": 1104,
        "issue": "The fail-closed branch only prints to stderr. A persistent config read failure silently flips every model-based review to the other tier with no bus or notify signal. This is acceptable for the fail-closed intent, but it is not observable.",
        "severity": "low"
      }

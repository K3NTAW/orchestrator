      "result": {
        "summary": "",
        "verdict": "approve",
        "comments": [
          {
            "path": "orchestrator/merge.py",
            "line": 19,
            "issue": "`git patch-id --stable` hashes only hunk lines and the file headers. The old code also hashed the `--binary` payload plus the stat. Binary-file content changes, or a mode-only change, may therefore produce the same id before and after a rebase, so a changed diff could merge without re-review. Consider mixing a hash of the binary blob or `--raw` output into the identity, or adding a test with a binary file.",
            "severity": "med"
          },
          {
            "path": "tests/test_merge.py",
            "line": 22,
            "issue": "The failure test counts `diff --binary` and `patch-id` calls (1 for before, 2 for after) instead of tracking rebase state. If `_diff_hash` gains extra calls, the test will silently target the wrong phase. It is acceptable now.",
            "severity": "low"
          }
        ],
        "packet_version": "5efd408eff64",

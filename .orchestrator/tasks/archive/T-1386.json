{
  "id": "T-1386",
  "created_at": 1790233431.446104,
  "parent": "T-1383",
  "role": "review",
  "tier": "sonnet",
  "complexity": 7,
  "title": "review: P2: merge compares patch-ids, not context-sensitive diff hashes, before and after rebase",
  "spec": "Goal T-1383. orchestrator/merge.py _diff_hash (merge.py:11) hashes `git diff --stat` + `git diff --binary` of target...HEAD, which includes hunk line numbers and context, so a clean rebase over an unrelated neighbouring change in the same file flips it and merge() returns rebase_changed_diff (merge.py:52) with no re-review path. Seen twice in luna-inbox on 2026-09-24 (T-0047, T-0057) where `git patch-id --stable` of the reviewed and rebased commits was identical. Change _diff_hash to return the `git patch-id --stable` of `git diff --binary target...HEAD` (pipe the diff into `git patch-id --stable`; empty diff -> a fixed sentinel string, not None; failure of either git call -> None as today). Keep the rebase_changed_diff branch and every other merge behaviour unchanged. Tests in tests/test_merge.py (unittest.TestCase methods): the existing reviewed-rebase test keeps passing (identical upstream content empties the patch -> rebase_changed_diff; unrelated upstream file -> merged); new case: upstream edits a different part of the same file (shifts context/line numbers), the task's patch applies cleanly -> merged, not rebase_changed_diff; new case: upstream change makes the task patch content differ -> rebase_changed_diff.",
  "inputs": [
    "T-1385"
  ],
  "acceptance": [
    "tests/test_merge.py::test_context_only_rebase_merges",
    "tests/test_merge.py::test_patch_content_change_after_rebase_holds",
    ".claude/hooks/tests-green.sh wt/<this task> exits 0"
  ],
  "scope": [
    "orchestrator/merge.py",
    "tests/test_merge.py"
  ],
  "depends_on": [],
  "constraints": {
    "read_only": true,
    "budget_turns": 20,
    "timeout_s": 900
  },
  "status": "done",
  "assigned_to": "claude:A",
  "worktree": "/Users/k3ntaw/code/orchestrator/wt/T-1386",
  "codex_thread": null,
  "result": {
    "summary": "",
    "verdict": "approve",
    "comments": [
      {
        "path": "orchestrator/merge.py",
        "line": 19,
        "issue": "`git patch-id --stable` hashes only hunk lines and the file headers. The old code also hashed the `--binary` payload plus the stat. Binary-file content changes, or a mode-only change, may therefore produce the same id before and after a rebase, so a changed diff could merge without re-review. Consider mixing a hash of the binary blob or `--raw` output into the identity, or adding a test with a binary file.",
        "severity": "med"
      },
      {
        "path": "tests/test_merge.py",
        "line": 22,
        "issue": "The failure test counts `diff --binary` and `patch-id` calls (1 for before, 2 for after) instead of tracking rebase state. If `_diff_hash` gains extra calls, the test will silently target the wrong phase. It is acceptable now.",
        "severity": "low"
      }
    ],
    "packet_version": "5efd408eff64",
    "confidence": 0.0,
    "provenance": [
      "repo"
    ]
  },

    "interface_contract": "eligible(task, *, priority, ready_priorities, evidence, snapshot, budget_left_usd, cfg=None) -> {eligible, reasons, executors}; shadow_estimate(root=STATE, evidence=None) -> rows; summary(rows); select_result(candidates) -> {selected, discarded, reason}; plan(task, **kwargs) -> {speculate, mode, reason, eligibility}; record(task_id, plan) writes decision_log kind speculation; config [speculation] mode off|shadow|active default off; evidence shape = allocation.evidence_for output {id: {cost_to_accepted_usd, first_pass_p, fix_round_cost_usd, n}}; snapshot shape = capacity.snapshot; must not import daemon or executor"

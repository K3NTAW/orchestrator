{
  "env": { "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1" },
  "hooks": {
    "TaskCreated":   [{ "hooks": [{ "type": "command", "command": ".claude/hooks/require-acceptance.sh" }] }],
    "TaskCompleted": [{ "hooks": [{ "type": "command", "command": ".claude/hooks/tests-green.sh" },
                                  { "type": "command", "command": ".claude/hooks/retrospect-written.sh" },
                                  { "type": "command", "command": ".claude/hooks/bus-post.sh" }] }],
    "TeammateIdle":  [{ "hooks": [{ "type": "command", "command": ".claude/hooks/no-uncommitted.sh" }] }],
    "Stop":          [{ "hooks": [{ "type": "command", "command": ".claude/hooks/loop-guard.sh" }] }],
    "PreToolUse":    [{ "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": ".claude/hooks/scope-guard.sh" }] }]
  }
}
